# ---------------------------------------------------------------------------
# InventDB PMS - Backend configuration
# Copy this file to ".env" and fill in your own values.
# ---------------------------------------------------------------------------

# Base URL of your InventDB instance (no trailing slash).
# For a sandbox this looks like: https://<slug>.sandbox.inventdb.com
# Register / create yours at https://www.inventdb.com
INVENTDB_BASE_URL=https://your-slug.sandbox.inventdb.com

# The namespace (database) inside InventDB that stores all PMS data.
# It is created automatically on first write.
INVENTDB_NAMESPACE=pms

# The app label sent to InventDB (used by /api/auth/me?app=...).
INVENTDB_APP=pms

# Comma-separated list of origins allowed to call this API (the frontend URL).
# Use * only for local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host / port for the API server.
API_HOST=0.0.0.0
API_PORT=8000

# Outbound request timeout (seconds) when talking to InventDB.
INVENTDB_TIMEOUT=30
