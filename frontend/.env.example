# Frontend build/runtime configuration.

# Base URL of the PMS backend API.
# - Leave as "/api" when the frontend is served by the backend or via the Vite
#   dev proxy (default).
# - Set to an absolute URL (e.g. https://api.example.com/api) when the frontend
#   is hosted separately from the backend.
VITE_API_BASE=/api

# Only used by the Vite dev server: where to proxy /api requests during `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8000
